# ReWave network — local environment template.
#
# Copy to .env (cp .env.example .env); .env is gitignored and loaded
# automatically at startup. Real environment variables always take
# precedence over .env values. See README.md ("Local development") for
# the full workflow.

# --- HTTP server ---
PORT=8080
HOST=0.0.0.0
# debug | info | warn | error
LOG_LEVEL=info

# --- Storage ---
# SQLite database of the media library (created and migrated automatically).
DB_PATH=data/network.db
# Root of the shared media pool as seen by the network.
MEDIA_ROOT=/media-pool
# Host-side path of the media pool — the bind source the network uses when
# it starts channel containers. Outside Docker the default (equal to
# MEDIA_ROOT) is usually right; inside Docker it must be the path on the
# Docker host.
# MEDIA_HOST_PATH=/srv/rewave/sample-media

# --- Channel lifecycle ---
# Docker socket used to start/stop channel containers.
DOCKER_SOCKET=/var/run/docker.sock
# Image channel containers are created from (build it from ../channel,
# e.g. docker build -t rewave-channel channel/).
CHANNEL_IMAGE=rewave-channel

# --- On-demand watching ---
# Keep-alive window in seconds after the last viewer leaves an on-demand channel.
WATCH_KEEPALIVE_SECONDS=300

# --- Authentication ---
# off = local development bypass (no token needed); jwks = OAuth2 resource server.
AUTH_MODE=off
# Required when AUTH_MODE=jwks:
# AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# AUTH_ISSUER=https://idp.example.com
# AUTH_AUDIENCE=rewave-network
